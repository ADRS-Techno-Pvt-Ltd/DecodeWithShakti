# Database
# For a managed provider with TLS (e.g. Neon), use sslmode=verify-full (not "require" —
# pg-connection-string is deprecating "require"/"prefer" as aliases for verify-full).
DATABASE_URL="postgresql://user:password@localhost:5432/decodewithshakti?schema=public"

# Auth.js
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Admin account(s) — used once by prisma/seed.ts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"
# Optional second admin — seeded only if both vars are set
ADMIN2_EMAIL=""
ADMIN2_PASSWORD=""

# Payment provider — "mock" for local dev, "cashfree" for real payments. See docs/CASHFREE-PLAN.md.
PAYMENT_PROVIDER="mock"
# Mock provider outcome (dev only) — success | failed | cancelled | pending
MOCK_PAYMENT_OUTCOME="success"
# Must be "true" to allow PAYMENT_PROVIDER=mock when NODE_ENV=production — a safety guard
ALLOW_MOCK_PAYMENTS=""

# Cashfree — only used when PAYMENT_PROVIDER=cashfree
CASHFREE_ENV="sandbox"                # sandbox | production
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
NEXT_PUBLIC_CASHFREE_ENV="sandbox"    # must match CASHFREE_ENV; exposed to the browser
CASHFREE_ORDER_EXPIRY_MINUTES="20"

# Shared secret for the VPS crontab hitting /api/v1/payment/reconcile
CRON_SECRET=""

# Contact form — the address the "Send message" button opens the visitor's mail client to
NEXT_PUBLIC_CONTACT_EMAIL="support@decodewithshakti.com"

# Email (Resend) — password-reset + contact-form delivery.
# EMAIL_FROM must be an address on a Resend-verified domain. Until a domain is
# verified, use "onboarding@resend.dev" (delivers only to the Resend account owner).
RESEND_API_KEY=""
EMAIL_FROM="Decode with Shakti <no-reply@decodewithshakti.com>"

# Invoice — company details printed on the generated PDF (all optional)
INVOICE_COMPANY_NAME="Decode with Shakti"
INVOICE_COMPANY_ADDRESS=""
INVOICE_COMPANY_EMAIL=""
INVOICE_COMPANY_GSTIN=""
INVOICE_COMPANY_WEBSITE=""

# File storage (Cloudinary)
#  - question-bank PDFs + previews + thumbnails -> "question-bank/<id>/..."
#  - invoices                                   -> "invoices/<invoiceNumber>"
# PDFs upload as type=authenticated (raw) and are only ever streamed back through the
# authenticated /api/v1/files/** routes; thumbnails upload as public images (CDN-delivered).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Cloudinary's max raw-file size is plan-dependent (10 MB on the free plan).
MAX_UPLOAD_MB="50"

# Uploaded (non-YouTube) lecture videos -> "videos/<id>/..." (type=authenticated, streamed
# via a short-lived signed URL, never buffered through our own server). YouTube-sourced
# videos store only the parsed video ID — no Cloudinary storage involved.
# Cloudinary's max video file size is plan-dependent (100 MB on the free plan).
MAX_VIDEO_MB="200"
