# Database
# For a managed provider with TLS (e.g. Neon), use sslmode=verify-full (not "require" —
# pg-connection-string is deprecating "require"/"prefer" as aliases for verify-full).
DATABASE_URL="postgresql://user:password@localhost:5432/decodewithshakti?schema=public"

# Auth.js
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Single admin account — used once by prisma/seed.ts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# Payment provider — "mock" for this phase; "cashfree" is reserved for a future plan
PAYMENT_PROVIDER="mock"

# SMTP (nodemailer) — used for password-reset emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ExamBank <no-reply@example.com>"

# File storage
# Absolute path in production, kept OUTSIDE the git-managed app directory so redeploys
# never touch uploaded question banks or invoices. Relative "./storage" is fine for local dev.
STORAGE_ROOT="./storage"
MAX_UPLOAD_MB="50"
