# Database
DATABASE_URL=""

# Auth.js
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Admin account(s) — used once by prisma/seed.ts
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Payment provider — "mock" for local dev, "cashfree" for real payments. See docs/CASHFREE-PLAN.md.
PAYMENT_PROVIDER="mock"
# Mock provider outcome (dev only) — success | failed | cancelled | pending
MOCK_PAYMENT_OUTCOME="success"
# Must be "true" to allow PAYMENT_PROVIDER=mock when NODE_ENV=production — a safety guard
ALLOW_MOCK_PAYMENTS=""

# Cashfree — only used when PAYMENT_PROVIDER=cashfree
CASHFREE_ENV="sandbox"               # sandbox | production
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
NEXT_PUBLIC_CASHFREE_ENV="sandbox"   # must match CASHFREE_ENV; exposed to the browser
CASHFREE_ORDER_EXPIRY_MINUTES="20"

# Shared secret for the VPS crontab hitting /api/v1/payment/reconcile
CRON_SECRET=""

# Contact form — the address the "Send message" button opens the visitor's mail client to
NEXT_PUBLIC_CONTACT_EMAIL=""

# Email (Resend) — password-reset, contact-form, and Mentorship purchase-confirmation delivery.
# EMAIL_FROM must be an address on a Resend-verified domain.
RESEND_API_KEY=""
EMAIL_FROM=""

# File storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
MAX_UPLOAD_MB="50"

# WhatsApp Click-to-Chat (wa.me) — student-initiated "Notify Mentor" link shown
# after a successful Mentorship purchase. Not a secret; exposed to the browser
# to build the https://wa.me/<number>?text=... link client-side.
NEXT_PUBLIC_WHATSAPP_ADMIN_NUMBER=""  # E.164 without "+", e.g. "919999999999"
