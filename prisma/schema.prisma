generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

enum PurchaseStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum VideoSource {
  YOUTUBE
  UPLOAD
}

enum AnswerSheetStatus {
  PENDING_EVALUATION
  EVALUATED
}

enum ProductType {
  QUESTION_BANK
  TEST_SERIES
  MENTORSHIP
}

model User {
  id                   String                  @id @default(cuid())
  name                 String
  email                String                  @unique
  phone                String?
  caRegistrationNumber String?
  passwordHash         String
  role                 Role                    @default(STUDENT)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  purchases            Purchase[]
  orders               Order[]
  passwordResetTokens  PasswordResetToken[]
  answerSubmissions    AnswerSheetSubmission[] @relation("AnswerSheetStudent")
  evaluatedSubmissions AnswerSheetSubmission[] @relation("AnswerSheetEvaluator")
  answerKeys           AnswerKey[]             @relation("AnswerKeyCreator")
  impersonationsMade     ImpersonationSession[] @relation("ImpersonationAdmin")
  impersonationsReceived ImpersonationSession[] @relation("ImpersonationTarget")
}

/// Audit trail for admin "View as user". One row per session: written when an
/// admin starts viewing a user's account, closed (endedAt set) when they exit.
/// Never deleted — this is the record of who looked at whose account and when.
model ImpersonationSession {
  id           String    @id @default(cuid())
  adminId      String
  admin        User      @relation("ImpersonationAdmin", fields: [adminId], references: [id])
  targetUserId String
  targetUser   User      @relation("ImpersonationTarget", fields: [targetUserId], references: [id])
  reason       String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([adminId, startedAt])
  @@index([targetUserId, startedAt])
}

model Category {
  id                String                  @id @default(cuid())
  name              String
  slug              String                  @unique
  questionBanks     QuestionBank[]
  videos            Video[]
  answerSubmissions AnswerSheetSubmission[]
  answerKeys        AnswerKey[]
  subjects          Subject[]
}

model Subject {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  questionBanks QuestionBank[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
}

model AnswerSheetSubmission {
  id                     String            @id @default(cuid())
  studentId              String
  student                User              @relation("AnswerSheetStudent", fields: [studentId], references: [id])
  questionBankId         String?
  questionBank           QuestionBank?     @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  categoryId             String
  category               Category          @relation(fields: [categoryId], references: [id])
  title                  String
  description            String
  studentFilePath        String
  studentFileName        String
  studentFileSizeBytes   Int
  evaluatedFilePath      String?
  evaluatedFileName      String?
  evaluatedFileSizeBytes Int?
  status                 AnswerSheetStatus @default(PENDING_EVALUATION)
  evaluatedById          String?
  evaluatedBy            User?             @relation("AnswerSheetEvaluator", fields: [evaluatedById], references: [id])
  submittedAt            DateTime          @default(now())
  evaluatedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([studentId, questionBankId])
  @@index([studentId, status, submittedAt])
  @@index([questionBankId, studentId, status])
  @@index([categoryId, status, submittedAt])
}

model AnswerKey {
  id             String        @id @default(cuid())
  title          String
  description    String
  questionBankId String?
  questionBank   QuestionBank? @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  filePath       String
  fileName       String
  fileSizeBytes  Int
  createdById    String
  createdBy      User          @relation("AnswerKeyCreator", fields: [createdById], references: [id])
  isPublished    Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId, isPublished, createdAt])
  @@index([questionBankId, isPublished, createdAt])
}

model QuestionBank {
  id                String                  @id @default(cuid())
  title             String
  type              ProductType             @default(QUESTION_BANK)
  slug              String                  @unique
  description       String
  categoryId        String
  category          Category                @relation(fields: [categoryId], references: [id])
  subjectId         String?
  subject           Subject?                @relation(fields: [subjectId], references: [id])
  price             Int
  earlyBirdPrice    Int?
  earlyBirdEndsAt   DateTime?
  // Mentorship is a service product and has no downloadable PDF. Question Bank
  // and Test Series creation validation still requires these fields.
  fileName          String?
  filePath          String?
  fileSizeBytes     Int?
  totalPages        Int?
  previewEnabled    Boolean                 @default(false)
  previewPageCount  Int?
  previewFilePath   String?
  thumbnailPath     String?
  isPublished       Boolean                 @default(true)
  isFeatured        Boolean                 @default(false)
  features          String[]                @default([])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  purchases         Purchase[]
  orderItems        OrderItem[]
  answerKeys        AnswerKey[]
  answerSubmissions AnswerSheetSubmission[]
}

model Video {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  description    String
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id])
  sourceType     VideoSource
  youtubeVideoId String?
  videoPath      String?
  thumbnailPath  String?
  durationSec    Int?
  fileSizeBytes  Int?
  isPublished    Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  expiresAt     DateTime
  usageLimit    Int
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  purchases     Purchase[]
  orders        Order[]
}

/// Homepage carousel banner — image-only slide (admin-uploaded), optionally linking
/// somewhere on click. Rendered above the hero on the marketing landing page; the
/// 44px side areas auto-peek the previous/next slide, so no separate side content exists.
model Banner {
  id          String   @id @default(cuid())
  imagePath   String
  linkUrl     String?
  altText     String   @default("")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Purchase {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  questionBankId     String
  questionBank       QuestionBank   @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  basePriceSnapshot  Int
  couponId           String?
  coupon             Coupon?        @relation(fields: [couponId], references: [id])
  couponCodeSnapshot String?
  discountAmount     Int            @default(0)
  amount             Int
  status             PurchaseStatus @default(PENDING)
  paymentProvider    String
  providerOrderId    String         @unique
  providerPaymentId  String?
  paymentMethod      String?
  expiresAt          DateTime?
  failureCode        String?
  failureReason      String?
  heldForReview      Boolean        @default(false)
  reconcileAttempts  Int            @default(0)
  refundedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  invoice            Invoice?
  paymentEvents      PaymentEvent[]
  orderId            String?
  order              Order?         @relation(fields: [orderId], references: [id])

  @@index([status, expiresAt])
  @@index([userId, questionBankId, status])
  @@index([orderId])
}

// One row per ProductType (TEST_SERIES, QUESTION_BANK, MENTORSHIP, ...) — seeded
// with all types disabled/0% on migration, admin turns each on individually.
model PromotionSetting {
  id                       String      @id @default(cuid())
  productType              ProductType @unique
  multiItemDiscountEnabled Boolean     @default(false)
  multiItemDiscountPercent Int         @default(0) // 0-100
  minQualifyingItems       Int         @default(2) // distinct SKUs of this type required to qualify
  updatedAt                DateTime    @updatedAt
}

model Order {
  id                            String         @id @default(cuid()) // == providerOrderId given to payment provider
  userId                        String
  user                          User           @relation(fields: [userId], references: [id])
  status                        PurchaseStatus @default(PENDING) // reuse existing enum
  paymentProvider               String
  providerOrderId               String         @unique
  providerPaymentId             String?
  paymentMethod                 String?
  subtotal                      Int
  couponId                      String?
  coupon                        Coupon?        @relation(fields: [couponId], references: [id])
  couponCodeSnapshot            String?
  couponDiscountAmount          Int            @default(0)
  bundleDiscountPercentSnapshot Int            @default(0)
  bundleDiscountAmount          Int            @default(0)
  amount                        Int // authoritative total, checked against paidAmount
  expiresAt                     DateTime?
  failureCode                   String?
  failureReason                 String?
  heldForReview                 Boolean        @default(false)
  reconcileAttempts             Int            @default(0)
  refundedAt                    DateTime?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  items                         OrderItem[]
  purchases                     Purchase[]

  @@index([status, expiresAt])
}

model OrderItem {
  id                String       @id @default(cuid())
  orderId           String
  order             Order        @relation(fields: [orderId], references: [id])
  questionBankId    String
  questionBank      QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  basePriceSnapshot Int
  amount            Int // this line's prorated share of order total
  createdAt         DateTime     @default(now())

  @@index([orderId])
}

model Invoice {
  id            String   @id @default(cuid())
  purchaseId    String   @unique
  purchase      Purchase @relation(fields: [purchaseId], references: [id])
  invoiceSeq    Int      @default(autoincrement())
  invoiceNumber String   @unique
  filePath      String
  amount        Int
  issuedAt      DateTime @default(now())
}

/// Append-only audit of every inbound provider event. Doubles as the
/// idempotency ledger: a duplicate (provider, eventId) is rejected by the
/// unique constraint before finalizePurchase is ever called.
model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String
  eventId         String
  eventType       String
  purchaseId      String?
  purchase        Purchase? @relation(fields: [purchaseId], references: [id])
  providerOrderId String?
  signatureValid  Boolean   @default(false)
  rawPayload      Json
  processedAt     DateTime?
  error           String?
  receivedAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([providerOrderId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
