generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
}

enum PurchaseStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FLAT
}

enum VideoSource {
  YOUTUBE
  UPLOAD
}

model User {
  id                   String               @id @default(cuid())
  name                 String
  email                String               @unique
  phone                String?
  caRegistrationNumber String?
  passwordHash         String
  role                 Role                 @default(STUDENT)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  purchases            Purchase[]
  passwordResetTokens  PasswordResetToken[]
}

model Category {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  questionBanks QuestionBank[]
  videos        Video[]
}

model QuestionBank {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  description      String
  categoryId       String
  category         Category   @relation(fields: [categoryId], references: [id])
  price            Int
  earlyBirdPrice   Int?
  earlyBirdEndsAt  DateTime?
  fileName         String
  filePath         String
  fileSizeBytes    Int
  totalPages       Int?
  previewEnabled   Boolean    @default(false)
  previewPageCount Int?
  previewFilePath  String?
  thumbnailPath    String?
  isPublished      Boolean    @default(true)
  isFeatured       Boolean    @default(false)
  features         String[]   @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  purchases        Purchase[]
}

model Video {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  description    String
  categoryId     String?
  category       Category?   @relation(fields: [categoryId], references: [id])
  sourceType     VideoSource
  youtubeVideoId String?
  videoPath      String?
  thumbnailPath  String?
  durationSec    Int?
  fileSizeBytes  Int?
  isPublished    Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  expiresAt     DateTime
  usageLimit    Int
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  purchases     Purchase[]
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Purchase {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  questionBankId     String
  questionBank       QuestionBank   @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  basePriceSnapshot  Int
  couponId           String?
  coupon             Coupon?        @relation(fields: [couponId], references: [id])
  couponCodeSnapshot String?
  discountAmount     Int            @default(0)
  amount             Int
  status             PurchaseStatus @default(PENDING)
  paymentProvider    String
  providerOrderId    String         @unique
  providerPaymentId  String?
  paymentMethod      String?
  expiresAt          DateTime?
  failureCode        String?
  failureReason      String?
  heldForReview      Boolean        @default(false)
  reconcileAttempts  Int            @default(0)
  refundedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  invoice            Invoice?
  paymentEvents      PaymentEvent[]

  @@index([status, expiresAt])
  @@index([userId, questionBankId, status])
}

model Invoice {
  id            String   @id @default(cuid())
  purchaseId    String   @unique
  purchase      Purchase @relation(fields: [purchaseId], references: [id])
  invoiceSeq    Int      @default(autoincrement())
  invoiceNumber String   @unique
  filePath      String
  amount        Int
  issuedAt      DateTime @default(now())
}

/// Append-only audit of every inbound provider event. Doubles as the
/// idempotency ledger: a duplicate (provider, eventId) is rejected by the
/// unique constraint before finalizePurchase is ever called.
model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String
  eventId         String
  eventType       String
  purchaseId      String?
  purchase        Purchase? @relation(fields: [purchaseId], references: [id])
  providerOrderId String?
  signatureValid  Boolean   @default(false)
  rawPayload      Json
  processedAt     DateTime?
  error           String?
  receivedAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([providerOrderId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
